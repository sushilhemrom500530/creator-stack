# Application
NODE_ENV=development
PORT=5000
APP_NAME="Creator Stack API"
API_PREFIX=api/v1

# Security & Auth
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
JWT_SECRET=super-secret-access-token-key-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-token-key-at-least-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cookie-signing-key
ENCRYPTION_KEY=super-secure-aes-256-encryption-key-32-chars

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/creator-stack
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (Nodemailer / SMTP)
NODE_MAILER_EMAIL=
NODE_MAILER_PASSWORD=

# Meta API (Facebook, Instagram, Threads)
META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL=http://localhost:5000/api/v1/social-accounts/oauth/facebook/callback
META_GRAPH_VERSION=v21.0

# Google OAuth (Auth & YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/v1/social-accounts/oauth/linkedin/callback

# X / Twitter API
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:5000/api/v1/social-accounts/oauth/x/callback

# WhatsApp Business Cloud API
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# AI Content Studio
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cloud Storage (Media Library)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
