# Application
NODE_ENV=development
PORT=3000
APP_NAME="Creator Stack API"
API_PREFIX=api/v1

# Security & Auth
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
JWT_SECRET=super-secret-access-token-key-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-token-key-at-least-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cookie-signing-key

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/creator-stack
REDIS_HOST=localhost
REDIS_PORT=6379
